	"license": "MIT",
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4",
		"vite": "^7.3.7",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"tex2typst": "file:./tex2typst"
	}
